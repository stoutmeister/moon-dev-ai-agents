# Skip Tracer + Wholesale Dialer — copy this file to ".env" and fill in your keys.
# The .env file is private and never uploaded (see .gitignore).

# AI (required) — the acquisitions rep + motivation scoring
ANTHROPIC_KEY=your_claude_key_here

# Skip tracing data (required to look up owner phone numbers)
BATCHDATA_API_KEY=your_batchdata_skip_trace_key_here

# Twilio — only needed for LIVE outbound calls (practice mode needs none of these)
TWILIO_ACCOUNT_SID=AC********************************
TWILIO_AUTH_TOKEN=********************************
TWILIO_PHONE_NUMBER=+1234567890

# Live dialer webhook — point at your running wholesale_dialer_webhook.py (via ngrok)
DIALER_WEBHOOK_URL=https://xxxx.ngrok.io/dialer/gather
